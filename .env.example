# NextAuth Configuration
# Generate a new secret: openssl rand -base64 32
AUTH_SECRET=your-secret-key-here-change-in-production
NEXTAUTH_SECRET=your-secret-key-here-change-in-production
NEXTAUTH_URL=http://localhost:3000

# Vercel Postgres (Optional - App works with mock data)
# Get these from Vercel Dashboard > Storage > Your Database > .env.local tab
POSTGRES_URL=
POSTGRES_PRISMA_URL=
POSTGRES_URL_NON_POOLING=
POSTGRES_USER=
POSTGRES_HOST=
POSTGRES_PASSWORD=
POSTGRES_DATABASE=

# Telegram Notifications (Optional)
# Create bot: https://t.me/BotFather -> /newbot
# Get chat ID: https://t.me/userinfobot or from getUpdates API
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
